# The Trader — cấu hình môi trường (nhân bản thành .env rồi điền giá trị)

# ── KHO DỮ LIỆU CHÍNH — Supabase Postgres (bền vững qua reset sandbox) ──
# Schema riêng "trader" (19 model Prisma) trên project Supabase của bạn;
# qua Supavisor session pooler :5432. Mật khẩu phải URL-encode (vd @ → %40).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=trader

# Supabase HTTPS — ops/quản trị qua Management API (tools/db-console.mjs)
# SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # ⚠️ bí mật — chỉ phía server
# SUPABASE_ACCESS_TOKEN=<sbp_-token>             # ⚠️ bí mật — Management API

# ── GitHub (push + khôi phục code sau reset sandbox) ──
# GITHUB_PAT=<personal-access-token>

# ── LLM PROVIDER CHO ĐỘI 23 AGENTS (src/lib/llm.ts) ───────────────────────
# LLM_PROVIDER=auto          # auto | opencode-cli | opencode-zen | zai
#   auto (mặc định): có key + có lệnh `opencode` trong PATH → opencode-cli;
#   có key không có lệnh → opencode-zen (REST — chỉ model TRẢ PHÍ);
#   không key → z-ai GLM-4.6 (chỉ chạy trong sandbox Z.ai).
# Lấy key: https://opencode.ai/zen → sign in → copy API key → điền dưới đây.
# ⚠️ Thực đo #92: model FREE bị Zen REST API chặn (403 FreeTierError
# "can only be used from within OpenCode") — chỉ chạy được QUA OPencode CLI
# (`opencode` trong PATH, cài: `bun add -g opencode-ai` / `npm i -g opencode-ai`).
# CLI cùng key oc_sk_ trả lời bình thường, cost 0, KHÔNG cần OAuth.
# OPENCODE_ZEN_API_KEY=<api-key-opencode-zen>
# OPENCODE_ZEN_MODEL=space-bunny-free   # chỉ là MẶC ĐỂNH KHỞI TẠO (#93):
#   đổi model ngay trên UI — nút "Model AI" trong workspace Đội Agent
#   (87 model live, 12 free $0 — lưu DB, không cần restart). 12 model free:
#   space-bunny-free · exo-free · ling-3.1-flash-free · ling-3.0-flash-fin-free ·
#   mimo-v2.6-flash-free · muse-spark-1.2-contributor-free · muse-spark-1.3-contributor-free ·
#   nemotron-3.5-lightning-free · nemotron-3-ultra-free · jev-1.13-free ·
#   step-5-preview-free · longcat-2.5-preview-free
# OPENCODE_CLI_BIN=opencode            # ghi đè đường dẫn lệnh CLI
# OPENCODE_CLI_TIMEOUT_MS=60000        # timeout mỗi lệnh gọi (mặc định 60s)
# OPENCODE_CLI_VARIANT=                # reasoning effort của CLI (vd low/minimal)
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1   # chỉ provider REST
# OPENCODE_ZEN_REASONING_EFFORT=low    # chỉ provider REST (low|medium|high|none)
# Chống 429 (#93 — đã bật mặc định, ghi đè nếu cần):
# LLM_MIN_SPACING_MS=900              # giãn cách tối thiểu giữa 2 lượt gọi
# LLM_MAX_CONCURRENT=2                # số cuộc gọi LLM song song tối đa
# Ghi đè bảng giá (USD/1M token) nếu đổi model trả phí:
# LLM_PRICE_IN_MTOK=0
# LLM_PRICE_OUT_MTOK=0

# ── Giai đoạn 2 ────────────────────────────────────────────────────
# S3 — Giao dịch thật VNDIRECT (mặc định TẮT: mọi Order là paper).
# Bật = true yêu cầu thêm 2 biến bên dưới; thiếu → API từ chối + audit log.
LIVE_TRADING=false
# VNDIRECT_API_BASE=https://api.vndirect.com.vn
# VNDIRECT_API_TOKEN=<token khách hàng VNDIRECT open API>

# S4 — true: engine chỉ sinh tick giá trong phiên HOSE (09:15–11:30 /
# 13:00–14:45, T2–T6, đã bỏ qua nghỉ lễ VN); false: demo 24/7 (đã gắn nhãn mô phỏng)
# Dữ liệu thị trường: EOD THẬT từ dchart VNDIRECT (public, không cần auth)
MARKET_DATA_MODE=real-eod
DCHART_BASE_URL=https://dchart-api.vndirect.com.vn
# true = tick chỉ sinh trong phiên HOSE (T2–T6) — ngoài giờ neo ở close thật
MARKET_STRICT_SESSION=true

# ── mini-services/market-engine (port 3003) ────────────────────────────
# TICK_MS=10000            # nhịp tick bảng giá (ms)
# NEWS_MS=900000           # chu kỳ nạp RSS (ms, mặc định 15 phút)
# AGENT_CYCLE_MINUTES=0    # chu kỳ agent tự động (0 = tắt, tiết kiệm LLM)
# APP_URL=http://localhost:3000
