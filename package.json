{
  "name": "the-trader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u DATABASE_URL next dev",
    "build": "next build",
    "start": "env -u DATABASE_URL next start",
    "lint": "eslint",
    "test": "bun test tests/",
    "smoke": "bun run scripts/p144-smoke-routes.ts",
    "db:push": "env -u DATABASE_URL prisma db push",
    "db:generate": "env -u DATABASE_URL prisma generate",
    "db:studio": "env -u DATABASE_URL prisma studio",
    "env:backup": "bun run scripts/env-crypt.ts encrypt",
    "env:restore": "bun run scripts/env-crypt.ts decrypt",
    "prepare": "bun run scripts/install-git-hooks.ts"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "docx": "^9.13.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "prisma": "^6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
