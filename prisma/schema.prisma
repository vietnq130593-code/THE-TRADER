// The Trader — Multi-Agent Trading System (VNDIRECT)
// Financial-grade schema: audit fields, soft delete, PII markers, indexes
// DB: Supabase Postgres (managed cloud, schema "trader") qua Prisma — kho dữ liệu
// chính bền vững qua reset sandbox; schema mirrors docs/DB_SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS (Postgres: native enum types trong schema "trader")
// ─────────────────────────────────────────────────────────────────

enum Market {
  HOSE // Sở Giao dịch Chứng khoán TP.HCM
  HNX // Sở Giao dịch Chứng khoán Hà Nội
  UPCOM // Thị trường OTC niêm yết
  US // Sàn quốc tế Mỹ (Yahoo Finance — MARKET_EXPANSION_BLUEPRINT B12)
  HK // Sàn quốc tế Hồng Kông (Yahoo Finance — MARKET_EXPANSION_BLUEPRINT B12)
}

enum InstrumentType {
  STOCK
  ETF
  FUND
  BOND
  INDEX
}

enum AgentRole {
  MARKET_ANALYST // phân tích kỹ thuật & macro
  NEWS_SENTIMENT // tin tức & cảm xúc thị trường
  RISK_MANAGER // quản trị rủi ro
  PORTFOLIO_STRATEGIST // chiến lược danh mục
  EXECUTION_MANAGER // thực thi lệnh
  // ── Mở rộng 23 agents (Gen-1 §4.1): S-dịch vụ + A-chuyên gia ──
  DATA_COLLECTOR // S0 — thu thập dữ liệu thị trường
  NOTIFICATION_OFFICER // S1 — thông báo & tổng hợp
  FEATURE_STORE // S2 — kho đặc trưng
  RL_GYM // S3 — môi trường giả lập RL
  FAIR_VALUE // A3 — định giá hợp lý
  LIQUIDITY // A5 — thanh khoản & dòng tiền
  EXPOSURE // A7 — phơi nhiễm danh mục (VETO)
  COMPLIANCE // A8 — tuân thủ quy định (VETO)
  DATA_INTEGRITY // A9 — toàn vẹn dữ liệu
  SETTLEMENT // A11 — thanh toán bù trừ
  CASH_MANAGEMENT // A12 — quản lý dòng tiền
  LEARNING_RAG // A13 — học tập & RAG
  BACKTEST // A14 — kiểm định lịch sử
  ML_FORECAST // A15 — dự báo machine learning
  RL_POLICY // A16 — chính sách RL
  DL_TRAINER // A17 — huấn luyện deep learning
  RL_TRAINER // A18 — huấn luyện RL
  MODEL_REGISTRY // A19 — đăng ký mô hình
}

enum AgentStatus {
  IDLE
  RUNNING
  ERROR
  PAUSED
}

enum SignalDirection {
  BUY
  SELL
  HOLD
}

enum SignalConfidence {
  LOW
  MEDIUM
  HIGH
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum RiskSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────
// 1. USERS & ACCOUNTS
// ─────────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())
  // PII
  email String @unique
  name String
  passwordHash String // PII (credential)
  phone String? // PII
  avatarUrl String?
  role String @default("trader") // trader | admin
  isActive Boolean @default(true)
  deletedAt DateTime? // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brokerAccounts BrokerAccount[]
  watchlists Watchlist[]
  auditLogs AuditLog[]
  orders Order[]
}

model BrokerAccount {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker String @default("VNDIRECT") // target broker
  accountNumber String // PII
  accountType String @default("basic") // basic | margin
  cashBalance BigInt @default(0) // VND, integer minor units (x1 VND)
  equity BigInt @default(0) // VND
  marginUsed BigInt @default(0) // VND
  currency String @default("VND")
  status String @default("ACTIVE")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  orders Order[]

  @@unique([broker, accountNumber])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────
// 2. MARKET DATA
// ─────────────────────────────────────────────────────────────────

model Instrument {
  id String @id @default(cuid())
  symbol String @unique // VCB, FPT, VHM... (quốc tế: giữ nguyên ký hiệu Yahoo — AAPL, 0700.HK, ^GSPC)
  name String
  market Market
  type InstrumentType @default(STOCK)
  // Đơn vị hiển thị theo (market, type) — bảng tra UnitSpec §3.2 là single source
  // of truth, KHÔNG có cột đơn vị riêng (tránh 2 nguồn sự thật lệch nhau).
  currency String? @default("VND") // VND | USD | HKD — display format theo này
  sector String? // banking, real-estate, technology...
  listingDate DateTime?
  outstandingShares BigInt? // số cổ phiếu lưu hành
  isActive Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
  bars Bar[]
  intradayBars IntradayBar[]
  signals Signal[]
  watchlistItems WatchlistItem[]
  positions Position[]
  orders Order[]
  trades Trade[]
  fundamentals FinancialFundamental[]
  corporateEvents CorporateEvent[]
  foreignFlows ForeignFlow[]

  @@index([market])
  @@index([sector])
}

model Quote {
  id String @id @default(cuid())
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  // prices in VND (integers, multiples of 100)
  open Int
  high Int
  low Int
  last Int // giá khớp gần nhất
  close Int?
  volume Int @default(0) // khối lượng khớp (cổ phiếu)
  bidPrice Int?
  bidVolume Int?
  askPrice Int?
  askVolume Int?
  change Int @default(0) // thay đổi so với close hôm trước
  changePct Float @default(0) // %
  refPrice Int? // giá tham chiếu
  ceilingPrice Int? // trần
  floorPrice Int? // sàn
  tradedAt DateTime // thời điểm báo giá
  createdAt DateTime @default(now())

  @@index([instrumentId, tradedAt])
}

model Bar {
  id String @id @default(cuid())
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date DateTime // trading day
  open Int
  high Int
  low Int
  close Int
  volume Int
  value BigInt? // giá trị giao dịch (VND)
  // P1-2 PIT tối thiểu (DATA_PLATFORM_BLUEPRINT v1.3 §5): firstSeenAt = lần
  // ĐẦU TIÊN thấy bar này (không bao giờ đổi sau tạo) · lastSyncedAt = lần
  // CUỐI nguồn xác nhận lại cùng giá trị (upsert eod-sync/intl-sync cập nhật).
  // → tái lập được "hồi đó dữ liệu thế nào" — rủi ro PIT duy nhất làm nghiên
  // cứu hồi tố SAI không phát hiện giờ có dấu vết (§9.1).
  firstSeenAt DateTime @default(now())
  lastSyncedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrumentId, date])
  @@index([instrumentId, date(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 3. MULTI-AGENT SYSTEM
// ─────────────────────────────────────────────────────────────────

// L1 (ML_LEARNING_BLUEPRINT §2 — phiên #83): chuỗi intraday 5-phút gom từ
// tick S4 — độ phân giải thời gian thứ HAI của hệ thống (Bar EOD là thứ nhất).
// Mục đích: mở lại cổng bằng chứng B2/GRU khi đủ dữ liệu (ML_OPS_BLUEPRINT
// §6 "Lớp chuỗi đầy đủ"). source đánh dấu trung thực nguồn tick góp bar:
// "simulated" (random-walk quanh ref thật) | "realtime-finfo" (giá cuối thật).
// date = ngày phiên ICT (neo 15:00Z cùng quy ước Bar) · startTime = mốc UTC
// bucket 5-phút (floor theo đồng hồ ICT) · volume = DELTA khối lượng dồn
// phiên trong bucket (Q3 chỉ tăng nên delta ≥ 0) · tickCount = số tick góp
// (phát hiện bucket đứt do restart — trung thực độ phủ).
model IntradayBar {
  id String @id @default(cuid())
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date DateTime // ngày phiên ICT (neo `${iso}T15:00:00.000Z` — cùng Bar)
  startTime DateTime // mốc UTC bắt đầu bucket 5-phút
  open Int
  high Int
  low Int
  close Int
  volume Int // KLGD delta trong bucket (tích luỹ dồn phiên trừ mốc đầu bucket)
  value BigInt? // giá trị ước tính (close × volume)
  source String @default("simulated") // simulated | realtime-finfo
  tickCount Int @default(1)
  firstSeenAt DateTime @default(now()) // PIT — không đổi sau tạo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrumentId, startTime])
  @@index([instrumentId, date])
  @@index([startTime])
  @@index([source])
}

model Agent {
  id String @id @default(cuid())
  code String @unique // e.g. "market-analyst"
  name String
  role AgentRole
  // Nhóm hiển thị & điều phối chu kỳ 23 agents (agent-roster.ts):
  // research | control | executive | platform | ml
  group String @default("research")
  description String
  model String @default("space-bunny-free") // LLM backbone (mặc định — runtime từ llm.ts)
  status AgentStatus @default(IDLE)
  config String @default("{}") // JSON: thresholds, weights
  lastRunAt DateTime?
  healthScore Float @default(100) // 0-100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AgentRun[]
  messagesFrom AgentMessage[] @relation("FromAgent")
  messagesTo AgentMessage[] @relation("ToAgent")
  tasks AgentTask[]
  signals Signal[]

  @@index([group])
}

model AgentRun {
  id String @id @default(cuid())
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskStatus TaskStatus @default(RUNNING)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?
  tokensIn Int @default(0)
  tokensOut Int @default(0)
  costUsd Float @default(0)
  output String? // JSON summary
  error String?
  createdAt DateTime @default(now())

  @@index([agentId, startedAt(sort: Desc)])
}

model AgentTask {
  id String @id @default(cuid())
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title String
  description String?
  status TaskStatus @default(PENDING)
  priority String @default("medium") // low | medium | high
  result String? // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([agentId, status])
}

model AgentMessage {
  id String @id @default(cuid())
  fromAgentId String
  fromAgent Agent @relation("FromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgentId String?
  toAgent Agent? @relation("ToAgent", fields: [toAgentId], references: [id], onDelete: SetNull)
  broadcast Boolean @default(true) // true = orchestrator broadcast
  // PHASE3_BLUEPRINT §4.1 — AGENT | USER (chat 1-1: fromAgentId = agent sở hữu thread,
  // kể cả tin USER gửi cho agent đó)
  direction String @default("AGENT")
  content String
  reasoning String?
  sentiment String? // bullish | bearish | neutral (for news agent)
  createdAt DateTime @default(now())

  @@index([fromAgentId, createdAt(sort: Desc)])
  @@index([toAgentId, createdAt(sort: Desc)])
  // F-116 (audit 19-a): feed message toàn cục sort theo createdAt — thêm index riêng
  @@index([createdAt])
  // PHASE3_BLUEPRINT §4.1 — truy vấn thread chat 1-1 của agent (broadcast=false)
  @@index([fromAgentId, broadcast, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 4. SIGNALS & ORDERS
// ─────────────────────────────────────────────────────────────────

model Signal {
  id String @id @default(cuid())
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  direction SignalDirection
  confidence SignalConfidence @default(MEDIUM)
  score Float @default(0) // 0-100 composite
  rationale String
  targetPrice Int? // VND
  stopLoss Int? // VND
  takeProfit Int? // VND
  agentId String? // originating agent
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // B9 — SNAPSHOT cổng đồng thuận lúc Chủ tịch SINH tín hiệu (gate bind theo
  // assessment tạo ra tín hiệu — convert chu kỳ sau KHÔNG bị đánh giá lại):
  // "CONSENSUS" | "WEAK_MAJORITY" | "NO_CONSENSUS" | null (chưa có cổng)
  consensusGate String?
  /** B9 — ratio trọng số tối đa 0..1 tại snapshot (để audit + hiển thị). */
  consensusRatio Float?
  expiresAt DateTime?
  actedAt DateTime? // khi được chuyển thành lệnh
  // PHASE3_BLUEPRINT §4.1 — vòng đời tín hiệu: ACTIVE | ACTED | REJECTED | EXPIRED
  status String @default("ACTIVE")
  rejectedAt DateTime?
  rejectNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([instrumentId, createdAt(sort: Desc)])
  @@index([direction, createdAt(sort: Desc)])
  // PHASE3_BLUEPRINT §4.1 — lọc tín hiệu đang mở cho prompt + tab Tín hiệu
  @@index([status, createdAt(sort: Desc)])
}

model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccountId String?
  brokerAccount BrokerAccount? @relation(fields: [brokerAccountId], references: [id], onDelete: SetNull)
  signalId String?
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  side OrderSide
  type OrderType @default(LIMIT)
  quantity Int // số cổ phiếu
  price Int? // giá đặt (VND), null cho MARKET
  filledQuantity Int @default(0)
  avgFillPrice Int?
  status OrderStatus @default(PENDING)
  fee BigInt @default(0) // phí môi giới (VND)
  note String?
  submittedAt DateTime?
  filledAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades Trade[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([instrumentId, createdAt(sort: Desc)])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// 5. POSITIONS & TRADES
// ─────────────────────────────────────────────────────────────────

model Position {
  id String @id @default(cuid())
  brokerAccountId String
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  quantity Int @default(0) // số cổ phiếu đang nắm giữ
  avgPrice Int @default(0) // giá vốn bình quân (VND)
  realizedPnl BigInt @default(0) // VND
  status PositionStatus @default(OPEN)
  openedAt DateTime @default(now())
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades Trade[]

  @@unique([brokerAccountId, instrumentId])
  @@index([status])
}

model Trade {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  positionId String?
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  side OrderSide
  quantity Int
  price Int // giá khớp (VND)
  fee BigInt @default(0)
  tax BigInt @default(0) // thuế TNCN 0.1% khi bán
  executedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([instrumentId, executedAt(sort: Desc)])
  // E-P0-3 (REV-9 review #69): window query đối chiếu ReconciliationReport lọc
  // THEO executedAt trên TOÀN bảng — composite [instrumentId, executedAt] không
  // phục vụ được (instrumentId đứng trước chặn index scan theo executedAt).
  @@index([executedAt])
}

// ─────────────────────────────────────────────────────────────────
// 6. RISK & COMPLIANCE
// ─────────────────────────────────────────────────────────────────

model RiskAlert {
  id String @id @default(cuid())
  severity RiskSeverity
  code String // e.g. RISK_MAX_DRAWDOWN
  message String
  metricKey String? // e.g. portfolio.drawdown
  metricValue Float?
  threshold Float?
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())

  @@index([severity, createdAt(sort: Desc)])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String // e.g. ORDER_CREATED
  entity String // e.g. "Order"
  entityId String?
  before String? // JSON
  after String? // JSON
  ip String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 7. WATCHLIST
// ─────────────────────────────────────────────────────────────────

model Watchlist {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @default("Danh mục theo dõi")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id String @id @default(cuid())
  watchlistId String
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([watchlistId, instrumentId])
}

// ─────────────────────────────────────────────────────────────────
// 8. NEWS & DATA-SOURCE STATUS (S5 news RSS + S4 stale marking)
//    — DATA_SOURCES.md §4.3/§4.2
// ─────────────────────────────────────────────────────────────────

// S5 — tin tức tài chính crawl từ RSS (VnEconomy/CafeF/VNExpress/Tuổi Trẻ).
// Dedupe theo `url` (Q4 DATA_SOURCES). Sentiment KHÔNG lưu ở đây — đó là
// việc của agent news-sentiment (AgentMessage.sentiment).
model NewsItem {
  id String @id @default(cuid())
  title String
  summary String? // trích dẫn ngắn, đã strip HTML
  url String @unique // khóa dedupe
  source String // VnEconomy | CafeF | VNExpress | Tuổi Trẻ | Seed
  sourceUrl String? // URL của feed gốc
  category String? // market | macro | company
  publishedAt DateTime // thời gian bài viết
  fetchedAt DateTime @default(now()) // lần crawl
  createdAt DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
  @@index([source, publishedAt(sort: Desc)])
}

// S4/S6 — trạng thái mỗi nguồn dữ liệu để đánh dấu live/simulated/stale
// (fallback strategy §6 DATA_SOURCES.md: serve last cache + mark stale).
model DataSourceStatus {
  id String @id @default(cuid())
  key String @unique // market-quotes | news | foreign-flows | trading
  label String // nhãn hiển thị tiếng Việt
  mode String // live | simulated | fallback | paper
  lastSuccessAt DateTime?
  lastError String?
  meta String? // JSON: provider, counts, chi tiết
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// 9. CÀI ĐẶT & BỘ TỔNG HỢP BAYES (phiên #34)
// ─────────────────────────────────────────────────────────────────

// Module Cài đặt — cấu hình runtime dạng key-value JSON, ghi đè env khi có.
// Secrets VNDIRECT (consumer key/secret, access token) lưu tại đây; API luôn
// mask khi trả về UI (chỉ 4 ký tự đầu + ****).
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique // "vndirect" | "market-data"
  value     String   // JSON payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// E-P1-3 (EXECUTION_OPS_BLUEPRINT v1.1 §4/§8): chuỗi snapshot tiền mặt theo
// thời gian — ĐIỀU KIỆN TIÊN QUYẾT của dự báo dòng tiền A12 (§8 đánh giá
// "chưa có chuỗi cash theo thời gian — cần snapshot mỗi chu kỳ"). A12 ghi
// 1 dòng mỗi chu kỳ (cash + equity); prune giữ 90 ngày để không phình vô hạn.
model CashSnapshot {
  id              String   @id @default(cuid())
  brokerAccountId String
  cash            BigInt // số dư tiền mặt lúc snapshot (VND)
  equity          BigInt // NAV lúc snapshot (VND)
  source          String   @default("cycle") // cycle | seed | manual
  createdAt       DateTime @default(now())

  @@index([brokerAccountId, createdAt(sort: Desc)])
}

// Bộ tổng hợp Bayes — posterior thị trường theo 3 bậc nhân quả
// (thị trường → nhóm ngành → cổ phiếu) sau mỗi chu kỳ 23 agents
// (source="cycle") hoặc tổng hợp lại thủ công (source="manual", 0 LLM).
model MarketAssessment {
  id              String   @id @default(cuid())
  source          String   @default("cycle") // cycle | manual
  cycleRunId      String? // AgentRun id của Chủ tịch khi chạy trong chu kỳ
  pUp             Float
  pDown           Float
  pFlat           Float
  marketDirection String // BULLISH | BEARISH | NEUTRAL
  confidence      Float    @default(0) // 0..1 — 1 − entropy chuẩn hoá
  disagreement    Float    @default(0) // 0..1 — phân hoá quan điểm các agent
  evidenceCount   Int      @default(0)
  detail          String // JSON: prior, drivers, sectors, symbols, market, veto, forecast5d, narrative, agentsConsidered
  createdAt       DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 11. DỮ LIỆU TÀI CHÍNH CƠ BẢN (MARKET_EXPANSION_BLUEPRINT B11 — finfo)
// ─────────────────────────────────────────────────────────────────

// Báo cáo tài chính theo mã × kỳ. Đơn vị: revenue/netProfit **VND nguyên**
// (BigInt), eps/bvps VND (Float), roe/roa/pe/pb là TỶ LỆ THÔ (0..n, không %).
// Kỳ nằm trong `period` ("Q1".."Q4" | "FY") + `year` — không có cột quarter
// riêng (dư thừa). mode: "real" (finfo sống) | "pending" (chờ egress sandbox).
model FinancialFundamental {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  period       String // Q1 | Q2 | Q3 | Q4 | FY
  year         Int
  revenue      BigInt? // VND nguyên
  netProfit    BigInt? // VND nguyên
  eps          Float? // VND
  bvps         Float? // VND
  roe          Float? // tỷ lệ thô (0.15 = 15%)
  roa          Float? // tỷ lệ thô
  pe           Float? // tỷ lệ thô
  pb           Float? // tỷ lệ thô
  source       String @default("finfo")
  mode         String @default("pending") // real | pending
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([instrumentId, period, year])
  @@index([instrumentId, year(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 12. PHÒNG HỌC MÁY (phiên #35 — Task 35-ML)
//    Thuật toán THẬT thuần TypeScript: MLP deep learning (nn.ts),
//    Q-learning tabular (rl.ts), Thompson sampling Beta-Bernoulli (bandit.ts).
// ─────────────────────────────────────────────────────────────────

// Mô hình học máy đã huấn luyện — mỗi lần train tạo 1 version mới,
// bản cũ cùng kind bị chuyển status "archived". weights/featureNorm/metrics
// lưu JSON string (MLP layers + z-score norm / Q-table 48×3).
model MlModel {
  id          String   @id @default(cuid())
  kind        String // "dl-mlp" | "rl-q"
  version     Int
  status      String   @default("serving") // serving | archived
  weights     String // JSON (MLP layers hoặc Q-table)
  featureNorm String? // JSON z-score mean/std (MLP)
  metrics     String // JSON: epochs/samples/trainAcc/valAcc/... hoặc episodes/epsilonEnd/avgReward/stance
  // P1-2 PIT (blueprint §5): window-hash SHA-256 + biên ngày train — tái lập
  // được cửa sổ dữ liệu đã dùng lúc train (meta JSON: windowHash · trainDateFrom ·
  // trainDateTo · samples · symbols · horizonDays · featureCount).
  meta        String? // JSON PIT — null với model train trước P1-2
  trainedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([kind, status])
}

// L1 (ML_LEARNING_BLUEPRINT §3 — phiên #83): log MỖI LẦN truy hồi RAG —
// đo được "RAG có được nhìn thấy/không" (cổng L3: ≥30 ngày & ≥10% chu kỳ).
// query/results dùng Json (string[] / mảng {refTable, refId, score}) theo
// quy tắc schema: primitive type không dùng list — Json giữ nguyên ý Text[].
model RetrievalLog {
  id           String   @id @default(cuid())
  cycleAt      DateTime @default(now()) // mốc chu kỳ gọi truy hồi
  query        Json // string[] — token truy vấn (symbols + từ khoá ngữ cảnh)
  topK         Int
  results      Json // [{refTable: "AgentMessage"|"NewsItem", refId, score}]
  usedInPrompt Boolean // true khi block được tiêm ≥1 prompt agent
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([usedInPrompt, createdAt])
}

// Cánh tay Thompson sampling — 6 arms = 5 LLM research agents
// (market-analyst, fair-value, news-sentiment, liquidity, risk-manager)
// + ml-forecast (B7 — cử tri thứ 6, ensemble MLP+linreg).
// Posterior Beta(α+1, β+1); reward 1 = vote đúng hướng realized 5 phiên, 0 = sai.
model BanditArm {
  id           String    @id @default(cuid())
  agentCode    String    @unique
  alpha        Float     @default(1) // Beta prior B(1,1)
  beta         Float     @default(1)
  pulls        Int       @default(0)
  wins         Float     @default(0)
  lastRewardAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// Phiếu bầu chờ settle + kết quả: mỗi phiếu LLM trong MarketAssessment
// (detail.drivers source "llm-vote:<code>") được đối chiếu realized direction
// của rổ top-10 sau 5 NGÀY GIAO DỊCH → reward. Dòng tồn tại = đã settle.
model BanditEvent {
  id           String    @id @default(cuid())
  assessmentId String
  agentCode    String
  direction    String // UP | DOWN | FLAT
  castAt       DateTime
  settledAt    DateTime?
  reward       Float?
  /** B8 — độ tự tin phiếu khi cast (0..1) để tính Brier score; MLP = max(pUp,pDown,pFlat). */
  confidence   Float?
  createdAt    DateTime @default(now())

  @@unique([assessmentId, agentCode])
  @@index([settledAt, castAt])
}

// ─────────────────────────────────────────────────────────────────
// 13. RISK QUANT ENGINE (phiên #51 — CONTROL_RISK_QUANT_BLUEPRINT v1.1 §7)
//    Snapshot 1 dòng/chu kỳ của Ủy ban Kiểm soát Định lượng — nguồn chuỗi
//    NAV cho CRB-6/8 PHA 2 + truy hồi lịch sử. detail = JSON string
//    (chuẩn codebase: MarketAssessment.detail cũng là String).
model RiskQuantSnapshot {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  nav              BigInt   @default(0) // VND — equity danh mục lúc chụp
  proxyMode        Boolean  @default(false) // true = rổ top-10 thay danh mục thật (§0.4)
  volEwmaAnnPct    Float    @default(0) // σ EWMA20 năm hoá (%)
  volRatio         Float    @default(1) // σ_now / σ_ref (1 = bình thường)
  dynMaxPositionPct Float  @default(25) // hạn mức vị thế động (% NAV — CRB-1×CRB-7)
  dynMaxSectorPct  Float   @default(40) // hạn mức ngành động (% NAV)
  var95Pct         Float    @default(0) // HS-VaR95 5 phiên (% NAV)
  cvar95Pct        Float    @default(0) // HS-CVaR95 5 phiên (% NAV)
  var95Vnd         BigInt   @default(0) // HS-VaR95 5 phiên (VND)
  mcLoss5Pct       Float    @default(0) // MC bootstrap: lỗ percentile 5% 5 bước (% NAV)
  mcPDd            Float    @default(0) // MC: P(chạm DD 15%)
  hhiSector        Float    @default(0) // CRB-4 — HHI ngành
  hhiPosition      Float    @default(0) // CRB-4 — HHI vị thế
  effSectors       Float    @default(0) // 1/HHI_sector — số ngành hiệu quả
  effBets          Float    @default(0) // CRB-5 — N_eff_bets
  avgCorr          Float    @default(0) // CRB-5 — tương quan TB các cặp vị thế
  cusumS           Float    @default(0) // CRB-8 — CUSUM downside hiện tại
  pBreach5d        Float? // CRB-6 — P(vi phạm 5 phiên) khi AUC ≥ 0,55, ngược lại null
  kellyHint        Float? // CRB-9 — ¼-Kelly gợi ý (% NAV / 100) cho tín hiệu chu kỳ
  detail           String   @default("{}") // JSON: limits, alerts, model metrics, breach flags…

  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────
// 14. SỰ KIỆN DOANH NGHIỆP + DÒNG KHỐI NGOẠI + BÁO CÁO CHẤT LƯỢNG
//    (phiên #60 — DATA_PLATFORM_BLUEPRINT v1.3 §5 P1-1 · P1-4 · P1-7)
// ─────────────────────────────────────────────────────────────────

// P1-1 — Sự kiện doanh nghiệp chia tách/cổ thưởng/cổ tức/restate.
// Chuỗi dchart VNDIRECT là PRE-ADJUSTED nhưng một số mã có gap vượt dải giá
// giới hạn sàn (§0.2 G5 — artefact thật, vd APC HNX ±14–16%) — sự kiện ẩn
// trong chuỗi giờ được GHI NHẬN kèm lớp an toàn đảo ngược (AuditLog pre-values
// + kill-switch AppSetting "corporate-event-autoadjust" + heuristic mức CAO).
// @@unique([instrumentId, date, kind]) chống trùng — upsert idempotent tự
// hội tụ khi eod-sync gửi lại chuỗi chưa chỉnh (blueprint P1-1 "hội tụ").
enum CorporateEventKind {
  SPLIT // chia tách / sáp nhập (f > 1 — hợp nhất; Yahoo split events)
  BONUS // cổ thưởng / chia tách làm giá giảm (f < 1 — phổ biến VN 1,2/1,3/1,5)
  DIVIDEND // cổ tức tiền mặt (Yahoo dividends — không đổi hệ số giá)
  RESTATE // điều chỉnh lại số liệu (dự phòng — chưa có nguồn tự động)
}

model CorporateEvent {
  id           String             @id @default(cuid())
  instrumentId String
  instrument   Instrument         @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date         DateTime // ngày giao dịch đầu tiên theo thang MỚI (ex-date)
  kind         CorporateEventKind
  // Hệ số nhân giá chuỗi TRƯỚC event: f = open[t]/close[t−1] (BONUS/SPLIT/
  // RESTATE — vd cổ thưởng 1:1,25 → f = 0,8); DIVIDEND = 0 (detail.amount).
  ratio        Float              @default(0)
  // AUTO_ADJUSTED (pipeline đã nhân chuỗi trước event — hoặc Yahoo adjclose
  // đã adjust sẵn) | SUSPECTED (gap vượt dải nhưng KHÔNG khớp heuristic mức
  // CAO — chỉ cảnh báo, không sửa giá) | REVERSED (đã đảo ngược bằng script
  // scripts/reverse-corporate-event.ts từ AuditLog pre-values).
  status       String             @default("SUSPECTED")
  source       String // gap-infer-dchart (VN) | yahoo-events (US/HK)
  detail       String             @default("{}") // JSON: pre-values, corroborate, note, adjustedBy
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([instrumentId, date, kind])
  @@index([instrumentId, date(sort: Desc)])
}

// P1-4 — Dòng khối ngoại ròng persist (trước đây re-sinh deterministic không
// lưu — G6 §0.5: B8 scorecard thiếu 1 arm dữ liệu). mode trung thực theo
// DataSourceStatus "foreign-flows": simulated (mô phỏng deterministic) |
// live (nguồn ngoài khi kết nối). netValue VND BigInt (clamp 2–80 tỷ).
model ForeignFlow {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date         DateTime // ngày giao dịch (convention 15:00 UTC như Bar)
  netValue     BigInt // VND — dương = mua ròng, âm = bán ròng
  mode         String // simulated | live
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([instrumentId, date])
  @@index([date(sort: Desc)])
}

// P1-7 — Báo cáo chất lượng dữ liệu chuẩn theo mốc asOf (thay AgentRun.output
// JSON của P0 KHI CẦN truy vấn lịch sử dài / trend). A9 mỗi chu kỳ INSERT 1
// dòng (AgentRun.output vẫn ghi song song — S1/extractVerdict đọc như cũ);
// index asOf DESC → truy vấn lịch sử < 100ms (test 8 mở rộng blueprint).
model DataQualityReport {
  id        String   @id @default(cuid())
  asOf      DateTime // mốc kiểm định (verdict.asOf)
  level     String // PASS | DEGRADED | SEVERE
  checks    String // JSON DqCheck[] — 6 phép + dbFail
  summary   String? // JSON DqSummary
  createdAt DateTime @default(now())

  @@index([asOf(sort: Desc)])
}

// P2-3 (phiên #62) — CACHE GIÁ TRỊ ĐẶC TRƯNG bằng bảng Postgres (kỷ luật §6
// blueprint: KHÔNG Redis — "nếu chậm → P2-3 dùng bảng Postgres"). Điều kiện
// đo #61: ~7-8 chỗ gọi topByAdtv/chu kỳ × ~106ms ≈ 750-850ms > ngưỡng 200ms.
// key dạng "topByAdtv:HOSE:STOCK:10"; value JSON-hoá payload; TTL L2 10 phút
// (L1 in-process 90s) + invalidation chủ động khi eod-sync/corporate-events đổi Bar.
model FeatureValue {
  key        String   @unique
  value      String // JSON-hoá payload (vd TopAdtvSymbol[])
  computedAt DateTime @default(now())
  expiresAt  DateTime // hết hạn đọc được — TTL L2 10 phút (FEATURE_CACHE_L2_TTL_MS; L1 in-process 90s — fixbug #63 F-63A-02)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

// P2-1 (phiên #62) — HỘP THƯ ĐI S1 NotificationOfficer (webhook/email).
// Pattern pending-egress như finfo: sandbox chặn egress → row giữ trạng thái
// PENDING_EGRESS (trung thực, tự retry mỗi chu kỳ S1 / POST /api/notify);
// máy chủ có egress → sweep gửi hết backlog.
model NotificationOutbox {
  id            String    @id @default(cuid())
  channel       String // WEBHOOK | EMAIL
  target        String // webhook URL hoặc địa chỉ email người nhận
  subject       String? // tiêu đề ngắn của bản tin
  payload       String // JSON-hoá nội dung bản tin S1
  status        String // PENDING_EGRESS | SENT | FAILED
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sentAt        DateTime?

  @@index([status, createdAt(sort: Desc)])
}
